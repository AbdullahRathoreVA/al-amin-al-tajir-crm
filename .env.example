# ---------------------------------------------------------------------------
# Tiny Stars Command Center — environment NAMES ONLY. Never commit real values.
# Copy to .env (which is gitignored) and fill in locally.
# ---------------------------------------------------------------------------

# Where the SQLite file lives. Relative paths resolve from the repo root.
CRM_DATA_DIR=./data

# Bind address. Keep it on loopback: this app has no business on a public port.
CRM_HOST=127.0.0.1
CRM_PORT=4317

# Signs session cookies. Generate with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# If unset, a key is generated on first run and stored in data/.session-key (mode 600).
CRM_SESSION_SECRET=

# Shared secret the PUBLIC WEBSITE uses to sign inbound registration webhooks.
# The website holds the same value as CRM_INGEST_SECRET in its own Vercel env.
# Generate a fresh one per environment. Never reuse the session secret.
CRM_INGEST_SECRET=

# Origin allowed to POST to the ingest endpoint (CORS + Origin check).
CRM_ALLOWED_ORIGIN=https://tiny-stars-demo-titan-2ac2.vercel.app

# 'demo'       — synthetic families, DEMO MODE banner everywhere, reset allowed
# 'production' — no synthetic data, reset disabled, stricter logging
CRM_MODE=demo

# --- Optional, all OFF by default. The CRM is fully functional without these. --
# CRM_AI_PROVIDER=          # unset | ollama | anthropic   (Phase 4)
# CRM_OLLAMA_URL=http://127.0.0.1:11434
# ANTHROPIC_API_KEY=
# GOOGLE_OAUTH_CLIENT_ID=   # Phase 3, Sheets sync
# GOOGLE_OAUTH_CLIENT_SECRET=
