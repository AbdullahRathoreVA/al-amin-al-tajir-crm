{
  "name": "al-amin-al-tajir-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tiny Stars Command Center \u2014 private, local-first childcare operations system.",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch packages/server/src/main.ts",
    "dev:web": "npm run dev -w @crm/web",
    "build": "npm run build -w @crm/web",
    "start": "node --disable-warning=ExperimentalWarning packages/server/src/main.ts",
    "db:migrate": "node --disable-warning=ExperimentalWarning packages/server/src/db/migrate.ts",
    "db:seed": "node --disable-warning=ExperimentalWarning packages/server/src/seed/demo.ts",
    "db:reset": "node --disable-warning=ExperimentalWarning packages/server/src/seed/reset.ts",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo-instance.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "user:list": "node --disable-warning=ExperimentalWarning packages/server/src/seed/users.ts list",
    "user:create": "node --disable-warning=ExperimentalWarning packages/server/src/seed/users.ts create",
    "user:password": "node --disable-warning=ExperimentalWarning packages/server/src/seed/users.ts password",
    "user:suspend": "node --disable-warning=ExperimentalWarning packages/server/src/seed/users.ts suspend",
    "user:activate": "node --disable-warning=ExperimentalWarning packages/server/src/seed/users.ts activate",
    "prod:check": "node --disable-warning=ExperimentalWarning packages/server/src/seed/production.ts check",
    "prod:harden": "node --disable-warning=ExperimentalWarning packages/server/src/seed/production.ts harden",
    "deploy": "node scripts/deploy-fly.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "backup": "node --disable-warning=ExperimentalWarning packages/server/src/seed/backup-cli.ts create",
    "backup:list": "node --disable-warning=ExperimentalWarning packages/server/src/seed/backup-cli.ts list",
    "backup:test": "node --disable-warning=ExperimentalWarning packages/server/src/seed/backup-cli.ts test",
    "backup:restore": "node --disable-warning=ExperimentalWarning packages/server/src/seed/backup-cli.ts restore"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.7.2"
  }
}
